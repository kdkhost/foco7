APP_NAME="Foco 7 - Rastreamento e Segurança"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foco7.com.br

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Conexão MySQL Obrigatória (100% Livre de SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fococomb_sistema
DB_USERNAME=fococomb_user
DB_PASSWORD=sua_senha_mysql_aqui

# Otimizado para cPanel compartilhado sem sobrecarga
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Credenciais Mercado Pago (Checkout Transparente)
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SANDBOX=true

# Credenciais Efí PRO (Gerencianet - PIX / Boleto / Cartão)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE=
EFI_SANDBOX=true

# Contato Oficial Foco 7
FOCO7_PHONE="0800 000 0000"
FOCO7_WHATSAPP="5591981117777"
FOCO7_EMAIL="contato@foco7.com.br"
